{
  "name": "chat2local",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "description": "让网页聊天（ChatGPT/Claude/DeepSeek 等）通过 CDP 读取本地文件、目录结构并运行测试文件——零扩展，Playwright 驱动专用浏览器实例",
  "scripts": {
