    "demo": "node scripts/smoke.mjs",
    "smoke:chat": "node scripts/smoke-chat.mjs",
    "smoke:watch": "node scripts/smoke-watch.mjs",
    "smoke:console": "node scripts/smoke-console.mjs",
    "smoke:profile": "node scripts/smoke-profile-lock.mjs",
    "console": "node src/cli.mjs console",
    "setup": "node src/cli.mjs setup",
    "ask": "node src/cli.mjs ask"
